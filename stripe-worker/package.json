{
  "name": "winigen-stripe-test-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "apply:pricing": "node ../scripts/apply-approved-pricing.mjs",
    "build:catalog": "node scripts/build-catalog.mjs",
    "seed:seo": "node ../seo/seed-product-catalog.mjs",
    "build:seo": "node ../seo/build-seo.mjs",
    "sync:assets": "node ../scripts/sync-static-asset-versions.mjs",
    "validate:assets": "node ../scripts/sync-static-asset-versions.mjs --check",
    "validate:seo": "node ../seo/validate-seo.mjs",
    "validate:pricing-master": "node ../scripts/validate-approved-pricing.mjs",
    "build:site": "node scripts/build-catalog.mjs && node ../seo/build-seo.mjs && node ../scripts/sync-static-asset-versions.mjs && node ../seo/validate-seo.mjs",
    "build:store": "node scripts/build-catalog.mjs && node ../scripts/build-product-search-index.mjs && node ../scripts/generate-public-product-pages.mjs && SEO_SCOPE=products node ../seo/build-seo.mjs && node ../scripts/sync-static-asset-versions.mjs && node ../seo/validate-seo.mjs && node ../scripts/validate-approved-pricing.mjs",
    "test:pricing": "node --test test/pricing.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply winigen-stripe-test-orders --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
