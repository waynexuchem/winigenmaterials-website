{
	"$schema": "./node_modules/wrangler/config-schema.json",
  "name": "winigen-stripe-test",
  "main": "src/index.js",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		}
	},
	"vars": {
    "CONTACT_REPORT_ENABLED": "false",
    "CONTACT_FORM_ENABLED": "false",
    "CONTACT_ACK_ENABLED": "false",
    "TURNSTILE_SITE_KEY": "",
		"SITE_ORIGIN": "https://www.winigenmaterials.com",
		"COMMERCE_ENABLED": "true",
		"STRIPE_MODE": "test",
		"EMAIL_MODE": "test",
		"EMAIL_PROVIDER": "resend",
		"TEST_ORDER_EMAIL_FROM": "orders@notify.winigenmaterials.com",
		"ORDER_EMAIL_REPLY_TO": "orders@winigenmaterials.com"
	},
	"secrets": {
		"required": [
			"STRIPE_SECRET_KEY",
			"STRIPE_WEBHOOK_SECRET",
			"RESEND_API_KEY",
			"TEST_ORDER_EMAIL_RECIPIENT"
		]
	},
	"d1_databases": [
		{
      "binding": "ORDERS_DB",
      "database_name": "winigen-stripe-test-orders",
      "database_id": "58e2b981-78be-41f6-a456-83cd4c613710",
			"migrations_dir": "migrations"
		}
	],
  "queues": {
    "producers": [
      {
        "binding": "CONTACT_QUEUE",
        "queue": "winigen-contact-test"
      }
    ],
    "consumers": [
      {
        "queue": "winigen-contact-test",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 8,
        "retry_delay": 60,
        "dead_letter_queue": "winigen-contact-test-dlq"
      }
    ]
  },
  "triggers": { "crons": ["*/15 * * * *", "0 13 * * MON"] }
}
